GEMINI_API_KEY1=
# Second provider in the fallback order, after GEMINI_API_KEY1.
NVIDIA_API_KEY=
# Third provider in the fallback order.
GEMINI_API_KEY2=
# Optional backward-compatible single-key fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Hosted NVIDIA API Catalog chat model; override with another chat model your key can access.
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
DATABASE_PATH=data/retail.sqlite3
MAX_UPLOAD_BYTES=26214400
MAX_DATABASES_PER_SESSION=5
MAX_IMPORT_ROWS=100000
MAX_IMPORT_SHEETS=20
MAX_IMPORT_CELLS=2000000
UPLOADS_DIR=data/uploads

